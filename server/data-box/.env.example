# data-box server settings. `make setup` copies this to .env and fills DATABOX_TOKEN.
# Clients (the plugin, Hermes, curl) send DATABOX_TOKEN as `Authorization: Bearer <token>`.
DATABOX_TOKEN=

# Most one call may spend by default, in US dollars. Paid steps that would exceed it never start.
DATABOX_SCRAPE_MAX_COST_USD=0.05

# ---- Paid sources: optional. Each one switches on when its key is set, billed to YOUR account. ----
# Some are still being wired into scrape's rungs; `status` shows what your server actually uses.
FIRECRAWL_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_PROXY_USER=
BRIGHTDATA_PROXY_PASSWORD=
DECODO_SCRAPER_API_TOKEN=
DECODO_PROXY_USER=
DECODO_PROXY_PASSWORD=
APIFY_TOKEN=

# A real browser as scrape's last rung: your browser-box's URL and token (optional).
DATABOX_BROWSERBOX_URL=
DATABOX_BROWSERBOX_TOKEN=

# /etc/data-box.env on the droplet: root:databox, mode 0640. Names only; never commit values.
# bootstrap.sh creates the file and generates DATABOX_TOKEN.
DATABOX_TOKEN=
DATABOX_HOST=127.0.0.1
DATABOX_PORT=8092
DATABOX_STATE_DIR=/var/lib/data-box

# Each provider turns on only the tools that need it; `status` names what is missing.
FIRECRAWL_API_KEY=
BRIGHTDATA_API_KEY=
DECODO_SCRAPER_API_TOKEN=
DECODO_PROXY_USER=
DECODO_PROXY_PASSWORD=
BRIGHTDATA_PROXY_USER=
BRIGHTDATA_PROXY_PASSWORD=
APIFY_TOKEN=
MOLTSETS_API_KEY=
DISCOLIKE_API_KEY=
HYPERBROWSER_API_KEY=
DATABOX_BROWSERBOX_URL=
DATABOX_BROWSERBOX_TOKEN=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Plans: every paid call runs inside a plan the user approved (defaults shown).
# DATABOX_FIRECRAWL_USD_PER_CREDIT=0.0038   Hobby: $19 for 5,000 credits; set to the real plan's rate
# DATABOX_PREFLIGHT_MAX_CREDITS=25          the only spend before approval
# DATABOX_PLAN_TTL_HOURS=24
# DATABOX_EXECUTE_CONCURRENCY=4             Firecrawl Hobby runs 5 jobs at once; leave one spare
# DATABOX_RETENTION_DAYS=30                 plan records (may hold contact data) are deleted after this
# DATABOX_FIRECRAWL_BALANCE_FLOOR=0         execution never takes the Firecrawl balance below this
# DATABOX_MIN_NEW_RATIO=0.3                 a cell stops paging when a page brings less than this share of new records
# DATABOX_SURVEY_MAX_CATEGORIES=6           Alexandria categories a survey reads in full
# DATABOX_CATALOG_TTL_HOURS=24              how long a category's tool list is reused

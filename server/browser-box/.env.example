# Copy to .env and fill in. .env is gitignored and must stay chmod 600.

# The bearer token every MCP client presents. Generate with: openssl rand -hex 32
BB_TOKEN=

# Resource caps. Defaults assume a 2 vCPU / 4 GB box.
# On a 1 vCPU / 2 GB box, lower STEEL_MEMORY to 850m and STEEL_CPUS to 0.7 — and read
# the warning in the README about why that box is not recommended.
STEEL_MEMORY=1536m
STEEL_CPUS=1.2
GATEWAY_MEMORY=256m
GATEWAY_CPUS=0.5

# How long a call waits for the single browser lane before returning "busy".
BB_LANE_WAIT_SECONDS=120

# The browser image reference, INCLUDING its separator.
#   :latest            — fine for a first run
#   @sha256:<digest>   — what production should use (the multi-arch manifest list digest)
# Verified 2026-09-22: this digest is the OCI image index covering linux/amd64 AND linux/arm64.
#   STEEL_REF=@sha256:7a161b95e8a9b20ddc2f87d380c61636bb13507f7fe99fd4704cb105c5478f99
STEEL_REF=:latest

# ── Orgo cloud computers (optional) ────────────────────────────────────────────
# Leave ORGO_API_KEY empty and the computer/task tools are simply not offered.
# Keys begin with sk_live_ (orgo.ai/start).
ORGO_API_KEY=
# Pin the computer to drive. Otherwise a running one is reused, or a stopped one started.
ORGO_COMPUTER_ID=
# Exactly one of: claude-sonnet-5, claude-opus-5, claude-opus-4.8, claude-sonnet-4.6,
# claude-opus-4.6. Note the DOT in 4.6 — "claude-sonnet-4-6" is rejected with 400.
ORGO_MODEL=claude-sonnet-5
# A computer bills until it is stopped; there is no auto-stop. Set to 1 to allow this
# box to CREATE one when none exists. Off by default on purpose.
BB_ORGO_AUTOCREATE=

# ── Jev: the act tool (optional) ────────────────────────────────────────────────
# Jev decides which element each plain-words step means ("click the pricing link") and drives
# the one browser. Leave COMPOSE_PROFILES without jev and act is simply not offered.
# To enable: set all of the below, then `make up` (it builds agent-jev first).
COMPOSE_PROFILES=
#   COMPOSE_PROFILES=jev               act only
#   COMPOSE_PROFILES=jev,browseruse    act and task(surface="browser")
BB_JEV_URL=
#   BB_JEV_URL=http://agent-jev:3111
# Shared by the gateway and agent-jev. Generate with: openssl rand -hex 24
BB_JEV_TOKEN=
# TypeSafe key for Jev's decisions. Without it agent-jev falls back to keyword heuristics.
TYPESAFE_API_KEY=
# A checkout of jev-automation, and the exact commit to build. The build reads that commit from
# git (git archive), never the checkout's working files, so uncommitted work there is ignored.
JEV_DIR=../jev-automation
JEV_REF=
JEV_MEMORY=384m
JEV_CPUS=0.5

# ── Browser-Use: task(surface="browser") (optional) ─────────────────────────────
# An LLM step loop that works a whole goal in the one browser, in a tab of its own. Add
# browseruse to COMPOSE_PROFILES above and set all three; empty = the browser surface of task
# is not offered.
BB_BROWSERUSE_URL=
#   BB_BROWSERUSE_URL=http://agent-browseruse:3120
# Shared by the gateway and agent-browseruse. Generate with: openssl rand -hex 24
BB_BROWSERUSE_TOKEN=
# The step model's key (openrouter.ai/keys). Each step is one model call; status reports cost.
OPENROUTER_API_KEY=
BB_BROWSERUSE_MODEL=z-ai/glm-5.3-flash
BROWSERUSE_MEMORY=640m
BROWSERUSE_CPUS=0.6

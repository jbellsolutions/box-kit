# Copy to .env and fill in. .env is gitignored and must stay chmod 600.

# The bearer token every MCP client presents. Generate with: openssl rand -hex 32
BB_TOKEN=

# Resource caps. No browser runs on this host; these are the two containers.
GATEWAY_MEMORY=256m
GATEWAY_CPUS=0.5

# ── Browser Use Cloud: the only main browser lane ──────────────────────────────────────────────
# read, session, act and task run on hosted Chromium here: a browser per call, many at once (the
# plan's concurrentSessionLimit), $0.02 per browser-hour billed by the minute. Pay as you go, no
# subscription: $1 free credit on sign-up, 10 browsers at once before any payment. Empty = no Browser Use:
# read can still use Browserbase (below); session, act and task(surface="browser") are not offered.
BROWSER_USE_API_KEY=
# CAPTCHA solving on Browser Use and Browserbase browsers. 1 = on (the default); 0 = off.
BB_SOLVE_CAPTCHAS=1
# Where the gateway records the id of every Browser Use browser it creates. After a crash it stops those,
# and only those: it never searches the account, which also holds other tools' browsers and profiles.
# This box never creates, opens or deletes a Browser Use profile; every browser is fresh and logged out.
BB_OWNED_BROWSERS=/tmp/browser-box/owned-browsers.json
# Box-side cap on this month's Browser Use browser spend, in USD, from Browser Use's own per-browser costs.
BB_BROWSERUSE_MONTHLY_USD=10
# Never more browsers at once than this, even when the plan allows more.
BB_BROWSERUSE_MAX_CONCURRENT=10
# Each browser's timeout in minutes: charged up front, refunded pro rata when it is stopped.
BB_BROWSERUSE_SESSION_MINUTES=5
# A session's browser closes after this many idle seconds, and the session is gone.
BB_SESSION_IDLE_SECONDS=300
# The longest a session's browser stays open, in minutes.
BB_SESSION_MAX_MINUTES=60

# ── act: the decision model (optional) ─────────────────────────────────────────────────────────
# Jev (TypeSafe) decides which element each plain-words step means; the gateway does the step.
# act is listed only when this AND BROWSER_USE_API_KEY are set.
TYPESAFE_API_KEY=
# Optional: another decision server speaking TypeSafe's API (e.g. Cloudflare's Clef). Default: Jev.
BB_DECISION_URL=
BB_DECISION_MODEL=

# ── Browserbase: the emergency lane (optional, docs/choosing.md) ───────────────────────────────
# Empty key = no emergency lane. With a key, read, act (any session) and task fall back to a hosted
# Browserbase browser when Browser Use cannot open one. Every browser is fresh and logged out.
# CAPTCHA solving follows BB_SOLVE_CAPTCHAS (above).
BROWSERBASE_API_KEY=
# Optional when the key has exactly one project.
BROWSERBASE_PROJECT_ID=
# Refuse new sessions once Browserbase's usage count for the project reaches this (the $20 plan: 100;
# the $0 Free plan is 60 minutes, so 1; it allows 3 at once and has no CAPTCHA solving).
BB_BROWSERBASE_MONTHLY_HOURS=100
# Sessions this box holds at once: the plan's own ceiling (Developer 25, Startup 100). No lower lock.
BB_BROWSERBASE_MAX_CONCURRENT=25
# Seconds a Browserbase session may live before Browserbase ends it (min 60).
BB_BROWSERBASE_TIMEOUT=120

# ── Browser-Use: task(surface="browser") (optional) ─────────────────────────────────────────────
# An LLM step loop that works a whole goal in a hosted browser the gateway opens for each task.
# Needs BROWSER_USE_API_KEY (above). Add browseruse to COMPOSE_PROFILES and set all three below;
# empty = the browser surface of task is not offered.
COMPOSE_PROFILES=
#   COMPOSE_PROFILES=browseruse
BB_BROWSERUSE_URL=
#   BB_BROWSERUSE_URL=http://agent-browseruse:3120
# Shared by the gateway and agent-browseruse. Generate with: openssl rand -hex 24
BB_BROWSERUSE_TOKEN=
# The step model's key (openrouter.ai/keys). Each step is one model call; status reports cost.
OPENROUTER_API_KEY=
BB_BROWSERUSE_MODEL=z-ai/glm-5.3-flash
# Sent as reasoning_effort on every step (low | medium | high). GLM 5.3 Flash cannot switch reasoning
# off; at its default effort steps take ~40 s, at low a few seconds.
BB_BROWSERUSE_REASONING_EFFORT=low
# Tasks that run at once. 0 = no cap of ours (Browser Use's plan limit is the ceiling). Each running task
# is a child process of about 100-300 MB, so the agent container's memory (BROWSERUSE_MEMORY) is the
# real bound; set a number here only as a memory guard on a small host.
BB_BROWSERUSE_PARALLEL=0
BROWSERUSE_MEMORY=1200m
BROWSERUSE_CPUS=0.6

# ── Orgo cloud computers (optional) ────────────────────────────────────────────────────────────
# Leave ORGO_API_KEY empty and the computer/task(surface="computer") tools are simply not offered.
# Keys begin with sk_live_ (orgo.ai/start).
ORGO_API_KEY=
# Pin the computer to drive. Otherwise a running one is reused, or a stopped one started.
ORGO_COMPUTER_ID=
# Exactly one of: claude-sonnet-5, claude-opus-5, claude-opus-4.8, claude-sonnet-4.6,
# claude-opus-4.6. Note the DOT in 4.6 — "claude-sonnet-4-6" is rejected with 400.
ORGO_MODEL=claude-sonnet-5
# A computer bills until it is stopped; there is no auto-stop. Set to 1 to allow this
# box to CREATE one when none exists. Off by default on purpose.
BB_ORGO_AUTOCREATE=
# How long a call waits for a busy Orgo computer (one driver per desktop) before returning "busy".
BB_LANE_WAIT_SECONDS=120
